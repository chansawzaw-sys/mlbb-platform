# Port the standalone server listens on. The host (Railway/Docker)
# injects this in production; when unset the server defaults to 3000.
PORT=3000

# Directory that holds the app database (app.db) and the blob store
# (blobs/). In the Docker layout this MUST be /data (the volume mount);
# when unset the server defaults to ./data next to server.ts.
DATA_DIR=/data
