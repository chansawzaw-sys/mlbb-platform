# --- Codespaces snapshot: TEXT files only (GitHub connector push) ---
# Python env / caches
.venv/
__pycache__/
*.pyc

# Secrets — never commit
.env
# Build 192 .env write lock + atomic-write temp files
.env.lock
.env.tmp.*
# Rendered tunnel client configs (node credential) — xray-era
# (builds 189/190) and the sing-box config (build 191)
tun-xray.json
tun-singbox.json
# Build 192 failover candidates cache (subscription body — a
# credential like the config)
tun-candidates.cache
# Build 236 Bilibili login session (the owner's Bilibili
# cookies — a credential, exactly like the tunnel config)
bilibili-cookies.txt
bilibili-cookies.txt.tmp
# Build 190 runtime state: tunnel activation diagnosis + markers
tun-status.json
.settings-activated.tg.sha
.settings-activated.tun.sha

# Runtime data (regenerated by the app)
jobs/
previews/
uploads/
models/

# Binary assets — fetched by setup-codespace.sh at Codespace start
assets/fonts/

# Local verification artefacts (frames/videos stay local only)
verification/*.mp4
verification/*.png
verification/*.jpg
verification/*.jpeg
