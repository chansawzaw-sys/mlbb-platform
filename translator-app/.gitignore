# --- Codespaces snapshot: TEXT files only (GitHub connector push) ---
# Python env / caches
.venv/
__pycache__/
*.pyc

# Secrets — never commit
.env

# Runtime data (regenerated by the app)
jobs/
previews/
uploads/
models/

# Binary assets — fetched by setup-codespace.sh at Codespace start
assets/fonts/

# Local verification artefacts (frames/videos stay local only)
verification/*.mp4
verification/*.png
verification/*.jpg
verification/*.jpeg
